        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 拒绝了媒体流请求（返回了 %2$lld 字节的 HTML 错误页，可能是令牌过期或 IP 不匹配）。请刷新页面后重新捕获。"
